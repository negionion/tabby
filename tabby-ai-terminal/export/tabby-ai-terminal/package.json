{
  "name": "tabby-ai-terminal",
  "version": "1.0.231-nightly.0",
  "description": "Tabby's AI-assisted terminal panel",
  "keywords": [
    "tabby-builtin-plugin"
  ],
  "main": "dist/index.js",
  "typings": "typings/index.d.ts",
  "scripts": {
    "build:typings": "node ../node_modules/typescript/bin/tsc --project tsconfig.typings.json",
    "build": "node ../node_modules/webpack/bin/webpack.js --config webpack.config.mjs",
    "prepack": "yarn run build:typings && yarn run build",
    "pack:plugin": "yarn run build:typings && yarn run build && node scripts/pack-plugin.mjs",
    "watch": "node ../node_modules/webpack/bin/webpack.js --config webpack.config.mjs --watch"
  },
  "files": [
    "dist/index.js",
    "typings"
  ],
  "author": "Tabby Developers",
  "license": "MIT",
  "peerDependencies": {
    "@angular/core": "^15",
    "@angular/common": "^15",
    "@angular/forms": "^15",
    "tabby-core": "*",
    "tabby-settings": "*",
    "tabby-terminal": "*"
  }
}
