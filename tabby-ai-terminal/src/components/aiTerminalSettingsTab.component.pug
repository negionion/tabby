h3.mb-3(translate) AI terminal

.form-line
    .header
        .title(translate) System prompt
        .description(translate) Instructions sent to the AI before the user request and captured terminal output.
    textarea.form-control(
        rows='8',
        [(ngModel)]='config.store.aiTerminal.systemPrompt',
        (ngModelChange)='config.save()',
    )

.form-line
    .header
        .title(translate) Session output limit
        .description(translate) Keep only the latest N lines of terminal output for each analysis run.
    input.form-control(
        type='number',
        min='1',
        step='1',
        [(ngModel)]='config.store.aiTerminal.maxSessionOutputLines',
        [ngModelOptions]='{ updateOn: "blur" }',
        (ngModelChange)='fixSessionOutputLimit(); config.save()',
        (keyup.enter)='$any($event.target).blur()',
    )

.alert.alert-info
    span(translate) This limit applies to the terminal output stored for the AI panel and used when you click Analyze.

.form-line
    .header
        .title(translate) AI terminal font size
        .description(translate) Font size used by the AI terminal panel and sender.
    input.form-control(
        type='number',
        min='8',
        max='24',
        step='1',
        [(ngModel)]='config.store.aiTerminal.fontSize',
        [ngModelOptions]='{ updateOn: "blur" }',
        (ngModelChange)='fixFontSize(); config.save()',
        (keyup.enter)='$any($event.target).blur()',
    )

.form-line
    .header
        .title(translate) Ignore terminal empty input
        .description(translate) Skip terminal output caused by pressing Enter on an empty line, while still keeping prompts after real commands.
    toggle(
        [(ngModel)]='config.store.aiTerminal.ignoreEmptyEnterPrompts',
        (ngModelChange)='config.save()',
    )

.form-line
    .header
        .title(translate) Sender insert mode
        .description(translate) Whether saved tags and suggested commands replace the sender content or are added after it.
    select.form-control(
        [(ngModel)]='config.store.aiTerminal.senderCommandInsertMode',
        (ngModelChange)='config.save()',
    )
        option(value='replace', translate) Replace sender draft
        option(value='append', translate) Append to sender draft

h3.mt-4.mb-3(translate) Provider CLIs

.form-line
    .header
        .title(translate) Update provider CLIs automatically
        .description(translate) Runs claude update or codex update when the AI panel checks the provider, at most once per interval and only while no answer is running.
    toggle(
        [(ngModel)]='config.store.aiTerminal.cliAutoUpdate',
        (ngModelChange)='config.save()',
    )

.form-line
    .header
        .title(translate) CLI update interval (hours)
        .description(translate) Minimum time between automatic update checks for each CLI.
    input.form-control(
        type='number',
        min='1',
        step='1',
        [(ngModel)]='config.store.aiTerminal.cliUpdateIntervalHours',
        [ngModelOptions]='{ updateOn: "blur" }',
        (ngModelChange)='fixCliUpdateInterval(); config.save()',
        (keyup.enter)='$any($event.target).blur()',
    )

.form-line(*ngFor='let provider of providers')
    .header
        .title {{provider.label}} CLI
        .description {{describeCli(provider.id)}}
    button.btn.btn-secondary(
        (click)='updateCliNow(provider.id)',
        [disabled]='isCliUpdating(provider.id) || !cliVersions[provider.id]',
        translate,
    ) Update now
